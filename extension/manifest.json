{
  "manifest_version": 2,
  "name": "WireGuard for Firefox",
  "version": "0.2.1",
  "description": "Select app-managed WireGuard profiles for Firefox browsing on macOS.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-wireguard@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent", "locationInfo"]
      }
    }
  },
  "permissions": ["proxy", "privacy", "storage", "nativeMessaging", "webRequest", "webRequestBlocking", "<all_urls>"],
  "background": {"scripts": ["details.js", "controller.js", "background.js"], "persistent": true},
  "browser_action": {"default_title": "WireGuard for Firefox", "default_popup": "popup.html", "default_icon": "icon.svg"},
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
